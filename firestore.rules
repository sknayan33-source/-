rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['eventType', 'createdAt']) &&
        data.keys().hasOnly(['eventType', 'details', 'sessionId', 'createdAt']) &&
        data.eventType is string &&
        data.eventType.size() <= 40 &&
        data.createdAt is string &&
        data.createdAt.size() <= 40 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 100)) &&
        (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 64));
    }

    function isValidAppStats(data) {
      return data.keys().hasOnly(['totalVisits', 'totalInstalls', 'totalPlays', 'totalQuizzes', 'totalTracing', 'totalShares', 'lastUpdated']) &&
        (!('totalVisits' in data) || data.totalVisits is number) &&
        (!('totalInstalls' in data) || data.totalInstalls is number) &&
        (!('totalPlays' in data) || data.totalPlays is number) &&
        (!('totalQuizzes' in data) || data.totalQuizzes is number) &&
        (!('totalTracing' in data) || data.totalTracing is number) &&
        (!('totalShares' in data) || data.totalShares is number) &&
        (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 40));
    }

    function isValidActiveSession(data) {
      return data.keys().hasAll(['sessionId', 'lastSeenMs', 'updatedAt']) &&
        data.keys().hasOnly(['sessionId', 'currentTab', 'currentActivity', 'isInstalledApp', 'deviceType', 'lastSeenMs', 'updatedAt']) &&
        data.sessionId is string && data.sessionId.size() <= 64 &&
        data.lastSeenMs is number &&
        data.updatedAt is string && data.updatedAt.size() <= 40 &&
        (!('currentTab' in data) || (data.currentTab is string && data.currentTab.size() <= 40)) &&
        (!('currentActivity' in data) || (data.currentActivity is string && data.currentActivity.size() <= 100)) &&
        (!('isInstalledApp' in data) || data.isInstalledApp is bool) &&
        (!('deviceType' in data) || (data.deviceType is string && data.deviceType.size() <= 40));
    }

    // Analytics Events collection
    match /analytics_events/{eventId} {
      allow create: if isValidId(eventId) && isValidAnalyticsEvent(incoming());
      allow read: if true;
    }

    // App Stats overview
    match /app_stats/{statId} {
      allow read: if isValidId(statId);
      allow create, update: if isValidId(statId) && isValidAppStats(incoming());
    }

    // Active Sessions (real-time live player presence)
    match /active_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isValidActiveSession(incoming());
    }

    // Global App Settings (such as custom banner watermark image)
    match /app_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update: if isValidId(settingId) &&
        incoming().keys().hasAll(['imageData', 'updatedAt']) &&
        incoming().keys().hasOnly(['imageData', 'updatedAt']) &&
        incoming().imageData is string &&
        incoming().imageData.size() <= 900000 &&
        incoming().updatedAt is string &&
        incoming().updatedAt.size() <= 40;
    }
  }
}
